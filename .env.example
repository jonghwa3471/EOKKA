# EOKKA environment variables
#
# - Never commit real secrets. This file contains names and safe examples only.
# - VITE_ values are exposed to the browser. Never store secrets in them.
# - Generate COOKIE_SECRET, RATE_LIMIT_HASH_SECRET, and CRON_SECRET separately
#   for each environment. BILLING_ENCRYPTION_KEY is required only when payments
#   are enabled and must also be unique per environment.
# - NODE_ENV, VERCEL_ENV, CI, and Vite's DEV/MODE are supplied automatically.

# =============================================================================
# 1. Local development — copy this active block to .env.development.local
# =============================================================================

APP_ENV=development
DATA_ENV=development
SITE_URL=http://localhost:5173

# Development Supabase project
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
DATABASE_PASSWORD=
ALLOW_PRODUCTION_DATABASE_COMMANDS=false

# Public browser configuration
VITE_APP_NAME=EOKKA
VITE_GOOGLE_TAG_ID=
VITE_CHANNEL_PLUGIN_KEY=

# Stock data and AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
FSC_STOCK_API_KEY=
# Optional. If empty, FSC_STOCK_API_KEY is also used for fundamentals.
FSC_FINANCIAL_API_KEY=
# KIS is for local domestic/US stock testing only.
KIS_APP_KEY=
KIS_APP_SECRET=
STOCK_MARKET_MODE=global-test

# Security and scheduled jobs
# Generate each secret with: openssl rand -base64 48
COOKIE_SECRET=
RATE_LIMIT_HASH_SECRET=
CRON_SECRET=
# Optional trusted proxy header: cf-connecting-ip | x-real-ip | x-forwarded-for
RATE_LIMIT_IP_HEADER=
AUTOMATIC_ANALYSIS_ENABLED=false

# Payments — keep disabled while payment service is unavailable.
PAYMENTS_ENABLED=false
VITE_TOSS_PAYMENTS_CLIENT_KEY=test_ck_
TOSS_PAYMENTS_SECRET_KEY=test_sk_
# Optional while PAYMENTS_ENABLED=false. Use at least 32 characters when true.
BILLING_ENCRYPTION_KEY=

# Application notification emails
# Outside production, every message is redirected to EMAIL_TEST_RECIPIENT.
EMAIL_DELIVERY_ENABLED=false
EMAIL_TEST_RECIPIENT=
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM="EOKKA <notifications@mail.qualius.co>"

# Monitoring and analytics
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# =============================================================================
# 2. Vercel Preview — register every value below with Preview scope only
# =============================================================================
# Use a development or staging Supabase project, never the production project.
# SITE_URL should be a stable Preview/branch domain registered in Supabase Auth.

# APP_ENV=preview
# DATA_ENV=preview
# SITE_URL=https://your-preview-domain.vercel.app

# SUPABASE_PROJECT_ID=
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# DATABASE_URL=
# DATABASE_PASSWORD=
# ALLOW_PRODUCTION_DATABASE_COMMANDS=false

# VITE_APP_NAME=EOKKA
# VITE_GOOGLE_TAG_ID=
# VITE_CHANNEL_PLUGIN_KEY=

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# FSC_STOCK_API_KEY=
# FSC_FINANCIAL_API_KEY=
# KIS_APP_KEY=
# KIS_APP_SECRET=
# STOCK_MARKET_MODE=domestic

# COOKIE_SECRET=
# RATE_LIMIT_HASH_SECRET=
# CRON_SECRET=
# RATE_LIMIT_IP_HEADER=x-forwarded-for
# AUTOMATIC_ANALYSIS_ENABLED=false

# PAYMENTS_ENABLED=false
# VITE_TOSS_PAYMENTS_CLIENT_KEY=test_ck_
# TOSS_PAYMENTS_SECRET_KEY=test_sk_
# Optional while PAYMENTS_ENABLED=false. Use at least 32 characters when true.
# BILLING_ENCRYPTION_KEY=

# Preview email is safe only when EMAIL_TEST_RECIPIENT is configured.
# EMAIL_DELIVERY_ENABLED=true
# EMAIL_TEST_RECIPIENT=your-test-email@example.com
# RESEND_API_KEY=
# NOTIFICATION_EMAIL_FROM="EOKKA <notifications@mail.qualius.co>"

# SENTRY_DSN=
# VITE_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# =============================================================================
# 3. Vercel Production — register every value below with Production scope only
# =============================================================================
# Use production Supabase and production-only secrets. STOCK_MARKET_MODE must be
# domestic. Keep payments and automatic analysis disabled until they launch.

# APP_ENV=production
# DATA_ENV=production
# SITE_URL=https://your-production-domain.example

# SUPABASE_PROJECT_ID=
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# DATABASE_URL=
# DATABASE_PASSWORD=
# ALLOW_PRODUCTION_DATABASE_COMMANDS=false

# VITE_APP_NAME=EOKKA
# VITE_GOOGLE_TAG_ID=G-XXXXXXXXXX
# VITE_CHANNEL_PLUGIN_KEY=

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# FSC_STOCK_API_KEY=
# FSC_FINANCIAL_API_KEY=
# KIS_APP_KEY=
# KIS_APP_SECRET=
# STOCK_MARKET_MODE=domestic

# COOKIE_SECRET=
# RATE_LIMIT_HASH_SECRET=
# CRON_SECRET=
# RATE_LIMIT_IP_HEADER=x-forwarded-for
# AUTOMATIC_ANALYSIS_ENABLED=false

# PAYMENTS_ENABLED=false
# Set live_ keys and a unique 32+ character encryption key only when
# PAYMENTS_ENABLED becomes true.
# VITE_TOSS_PAYMENTS_CLIENT_KEY=
# TOSS_PAYMENTS_SECRET_KEY=
# BILLING_ENCRYPTION_KEY=

# Production sends to the real recipient and ignores EMAIL_TEST_RECIPIENT.
# EMAIL_DELIVERY_ENABLED=true
# EMAIL_TEST_RECIPIENT=
# RESEND_API_KEY=
# NOTIFICATION_EMAIL_FROM="EOKKA <notifications@mail.qualius.co>"

# SENTRY_DSN=
# VITE_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# =============================================================================
# 4. Supabase Edge Function secrets — set with `supabase secrets set`
# =============================================================================
# These do not belong in Vercel. Configure them separately for each Supabase
# project used by development/Preview and Production.

# RESEND_API_KEY=
# SEND_EMAIL_HOOK_SECRET=
# AUTH_EMAIL_FROM="EOKKA <eokka@mail.qualius.co>"

# =============================================================================
# 5. Local maintenance and E2E test variables — optional
# =============================================================================

# Keep downloaded KIS stock master files after a sync: 1 | 0
KEEP_STOCK_MASTER_FILES=0

# Playwright local server port. CI is normally supplied by the CI platform.
PORT=4000

MAGIC_LINK_TEST_USER_EMAIL=
LOGIN_TEST_USER_EMAIL=
JOIN_TEST_UNCONFIRMED_USER_EMAIL=
JOIN_TEST_EXISTING_USER_EMAIL=
FORGOT_PASSWORD_TEST_USER_EMAIL=
EDIT_PROFILE_TEST_USER_EMAIL=
CHANGE_EMAIL_TEST_USER_EMAIL=
CHANGE_EMAIL_TEST_USER_NEW_EMAIL=
CHANGE_PASSWORD_TEST_USER_EMAIL=
DELETE_PROFILE_TEST_USER_EMAIL=
