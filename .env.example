# Runtime environment: development | preview | production | test
APP_ENV=development
# Must never be production on a local or Preview deployment.
DATA_ENV=development
SITE_URL=http://localhost:5173

# Use a separate Supabase project for local development.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
DATABASE_PASSWORD=
# Set only for an intentional one-off production DB command.
ALLOW_PRODUCTION_DATABASE_COMMANDS=false

# Browser-visible values may use VITE_. Never put a secret in a VITE_ variable.
VITE_APP_NAME=EOKKA
VITE_TOSS_PAYMENTS_CLIENT_KEY=test_ck_
TOSS_PAYMENTS_SECRET_KEY=test_sk_
PAYMENTS_ENABLED=false
BILLING_ENCRYPTION_KEY=

# External services
OPENAI_API_KEY=
FSC_STOCK_API_KEY=
KIS_APP_KEY=
KIS_APP_SECRET=
STOCK_MARKET_MODE=global-test
CRON_SECRET=
COOKIE_SECRET=
# Pro beta keeps automatic analysis disabled. Enable only after the feature is
# officially restored and a scheduler has been configured.
AUTOMATIC_ANALYSIS_ENABLED=false

# Development email is disabled by default. If enabled outside production,
# every notification email is redirected to EMAIL_TEST_RECIPIENT.
EMAIL_DELIVERY_ENABLED=false
EMAIL_TEST_RECIPIENT=
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=EOKKA <notifications@example.com>

# Monitoring and analytics
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
VITE_SENTRY_DSN=
VITE_GOOGLE_TAG_ID=
